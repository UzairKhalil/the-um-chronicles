// ---------------------------------------------------------------------------
// The U&M Chronicles — Realtime Database rules.
//
// THIS IS A FRAGMENT. DO NOT PASTE THIS FILE OVER THE LIVE RULESET.
//
// Rules are per-database, and this database (khalil-a67e5) is shared with
// another app. Publishing this file on its own would delete that app's rules
// and break it.
//
// TO PUBLISH:
//   1. Firebase console -> Realtime Database -> Rules.
//   2. Put the cursor on the blank line just after   "rules": {
//   3. Paste the "umc" block below (everything from  "umc": {  to  },  ).
//   4. Leave every other line exactly as it is.
//   5. Publish.
//
// As of the last check the live ruleset contained these top-level keys, all
// belonging to the other app: presence, invites, matches, games, logins.
// There is no top-level wildcard, so adding "umc" alongside them changes
// nothing about how those keys behave.
//
// Firebase's rules format allows these // comments; plain JSON does not,
// which is why nothing in the build parses this file. It is a paste source.
//
// This app has no authentication either: two codes that live in the bundle.
// These rules therefore cannot say WHO is writing. What they can do is
// constrain WHAT gets written, so a stray client cannot corrupt the shape of
// the data or let the database grow without bound.
// ---------------------------------------------------------------------------

    // The U&M Chronicles. Everything this app touches lives under this one
    // key, so it cannot collide with anything else in the database.
    "umc": {
      ".read": true,
      ".write": true,

      // One record per day per person. A day "counts" only when both ids are
      // present; that is judged on the client, from this data.
      "days": {
        "$day": {
          ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$person": {
            ".validate": "$person == 'u' || $person == 'm'",
            "at":     { ".validate": "newData.isNumber()" },
            "note":   { ".validate": "newData.isString() && newData.val().length <= 240" },
            "device": { ".validate": "newData.isString() && newData.val().length < 64" },
            "$other": { ".validate": false }
          }
        }
      },

      // A comment needs both a name and text. Enforced in the UI, and again
      // here so a stray client cannot write a nameless or empty one.
      "comments": {
        "$item": {
          "$id": {
            ".validate": "newData.hasChildren(['name', 'text', 'at']) && newData.child('name').val().length > 0 && newData.child('text').val().length > 0",
            "name":     { ".validate": "newData.isString() && newData.val().length <= 60" },
            "text":     { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "at":       { ".validate": "newData.isNumber()" },
            "personId": { ".validate": "newData.isString() && newData.val().length < 8" },
            "device":   { ".validate": "newData.hasChildren()" },
            "$other":   { ".validate": false }
          }
        }
      },

      // One reaction per person per item, keyed by person — so it toggles and
      // replaces instead of accumulating. It cannot be spammed into a counter.
      "reactions": {
        "$item": {
          "$person": {
            ".validate": "$person == 'u' || $person == 'm' || $person == 'g'",
            "symbol": { ".validate": "newData.val() == 'heart' || newData.val() == 'rose' || newData.val() == 'spark'" },
            "at":     { ".validate": "newData.isNumber()" },
            "name":   { ".validate": "newData.isString() && newData.val().length <= 60" },
            "device": { ".validate": "newData.hasChildren()" },
            "$other": { ".validate": false }
          }
        }
      },

      // Sign-in history for the admin page. Device details, never codes.
      // Capped at 300 entries by the client after each write.
      "signIns": {
        "$entry": {
          ".validate": "newData.hasChildren(['personId', 'at'])",
          "personId": { ".validate": "newData.isString() && newData.val().length < 8" },
          "name":     { ".validate": "newData.isString() && newData.val().length <= 60" },
          "at":       { ".validate": "newData.isNumber()" },
          "device":   { ".validate": "newData.hasChildren()" },
          "$other":   { ".validate": false }
        }
      },

      // One row per device seen, for the "devices seen" summary.
      "devices": {
        "$deviceId": {
          ".validate": "$deviceId.length < 64 && newData.hasChildren(['lastAt'])",
          "lastAt":  { ".validate": "newData.isNumber()" },
          "firstAt": { ".validate": "newData.isNumber()" },
          "visits":  { ".validate": "newData.isNumber()" },
          "ua":      { ".validate": "newData.isString() && newData.val().length <= 400" }
        }
      }
    },
